# Browser settings
HEADLESS=true
TIMEOUT=30000

# Anti-captcha settings (optional)
ANTICAPTCHA_API_KEY=

# MCP proxy settings (optional). Restart the MCP server after changes.
# Explicit false disables proxies; when unset, a URL or list file enables them.
PROXY_ENABLED=false
# Single proxy; takes precedence over PROXY_LIST_FILE. URL-encode credentials.
# PROXY_URL=http://user:password@proxy.example.com:8080
# PROXY_URL=socks5://user:password@proxy.example.com:1080
# Relative paths are resolved from the mcp-avito project root.
PROXY_LIST_FILE=./config/proxies.txt
# sequential | random | round-robin
PROXY_ROTATION=sequential
# Switch on the next tool call after a navigation/network error.
PROXY_ROTATE_ON_ERROR=true
# Number of page navigations, 0 disables periodic rotation.
PROXY_ROTATE_EVERY_N=0

# Delays (anti-bot)
DELAY_MIN=1000
DELAY_MAX=3000

# Output
DEFAULT_OUTPUT=console
